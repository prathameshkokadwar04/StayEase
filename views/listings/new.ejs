<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sayease </title>
</head>
<body>
    <h3>Create a new listing</h3>
    <form method="POST" action="/listings">
        <input name="title" placeholder="Enter title" type="text"><br><br>
        <textarea name="description" placeholder="Enter Description"></textarea><br><br>
        <input name="image" placeholder="Enter image or url" type="text"><br><br>
        <input name="price" type="number" placeholder="Enter price"><br><br>
        <input name="country" placeholder="Enter country" type="text"><br><br>
        <input name="location" placeholder="Enter location" type="text"><br><br>
            <button>Add</button>

    </form>
</body>
</html>